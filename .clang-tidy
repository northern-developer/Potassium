Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once
WarningsAsErrors: ''
HeaderFilterRegex: 'include/ptasm/.*'
FormatStyle: file
