{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ptasm machine file: a CPU, its ELF settings and its instruction encodings",
  "description": "Structure only. Cross-references (a format's fields exist, every field of a chosen format is filled exactly once, ...) are checked when ptasm loads the file.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "The schema an editor checks this file against: cpu_schema.json, by path or URL." },
    "include": {
      "type": "array", "items": { "type": "string" },
      "description": "The machine files this one builds on, merged first, in order, each relative to this file's folder."
    },
    "replace": {
      "type": "object",
      "description": "Changes to what the includes give, shaped like the file; null removes a key."
    },
    "models": {
      "type": "object",
      "description": "Named variants: each a container of fields, formats, modes, operandSets, modeSets and instructions, with its own \"replace\", building on other models by \"base\".",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "base": { "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ] },
          "registers": { "type": "object" },
          "replace": { "type": "object" },
          "fields": { "type": "object" }, "formats": { "type": "object" }, "modes": { "type": "object" },
          "operandSets": { "type": "object" }, "modeSets": { "type": "object" }, "instructions": { "type": "object" },
          "semSets": { "type": "object" }, "helpers": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "defaultModel": {
      "type": "string",
      "description": "The model applied unless another is chosen: one of the models, or the cpuName for the globals alone. Required with models."
    },
    "cpuName": { "type": "string" },
    "maxOperands": { "type": "integer", "minimum": 2, "maximum": 9 },
    "description": { "type": "object" },
    "elf": { "type": "object" },
    "registers": {
      "type": "object",
      "description": "The register list: each name, with its number, or an object.",
      "additionalProperties": { "$ref": "#/$defs/register" }
    },
    "fields": { "type": "object" },
    "formats": { "type": "object" },
    "modes": { "type": "object" },
    "operandSets": { "type": "object" },
    "modeSets": { "type": "object" },
    "instructions": { "type": "object" },
    "semSets": {
      "type": "object",
      "description": "Shared semantics, each by its name: an instruction's or a mode set's \"sem\" may name one, its {placeholders} filled from \"semArgs\".",
      "additionalProperties": { "$ref": "#/$defs/sem" }
    },
    "operandSemantics": {
      "type": "object",
      "description": "What an operand in a mode means, for $n and ea(n) in semantics: each mode (numbers written imm) with its \"ea\" (its address) and/or \"value\", expressions in its parts reg1, reg2, num1, num2. reg, imm, [reg], [imm], [reg + imm] and [reg + reg] are worked out; a memory operand's value defaults to a load at regBits.",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": { "ea": { "type": "string" }, "value": { "type": "string" } }
      }
    },
    "abi": {
      "type": "object",
      "description": "The calling convention, for a compiler and a debugger: register roles (registers are register-list names or R<n>), how arguments and results are passed, the C types, the frame, the breakpoint instruction. ptasm checks it; it doesn't use it.",
      "additionalProperties": false,
      "properties": {
        "stack": { "type": "object", "required": ["register"], "additionalProperties": false, "properties": {
          "register": { "type": "string" }, "grows": { "enum": ["down", "up"] }, "align": { "type": "integer", "minimum": 1 },
          "redZone": { "type": "integer", "minimum": 0 }, "minFrame": { "type": "integer", "minimum": 0 } } },
        "link": { "type": "string" },
        "frame": { "type": "object", "additionalProperties": false, "properties": {
          "register": { "type": "string" },
          "order": { "type": "array", "items": { "enum": ["lr", "fp", "calleeSaved", "locals", "outgoing"] } },
          "calleeSaved": { "enum": ["ascending", "descending"] }, "points": { "enum": ["cfa", "bottom"] } } },
        "threadPointer": { "type": "string" },
        "got": { "type": "string" },
        "globalPointer": { "type": "object", "required": ["register", "symbol"], "additionalProperties": false,
          "properties": { "register": { "type": "string" }, "symbol": { "type": "string" } } },
        "args": { "type": "object", "additionalProperties": false, "properties": {
          "registers": { "type": "array", "items": { "type": "string" } },
          "pair": { "enum": ["consecutive", "even"] }, "variadicPair": { "enum": ["consecutive", "even"] },
          "splitPair": { "type": "boolean" }, "variadic": { "enum": ["registers", "stack"] },
          "aggregates": { "enum": ["reference", "value"] }, "aggregateValueMax": { "type": "integer", "minimum": 0 },
          "stackBase": { "type": "integer", "minimum": 0 }, "homeSlots": { "type": "boolean" },
          "pairStackAlign": { "type": "integer", "minimum": 1 } } },
        "returns": { "type": "object", "additionalProperties": false, "properties": {
          "registers": { "type": "array", "items": { "type": "string" } },
          "sret": { "type": "object", "required": ["pointer"], "additionalProperties": false, "properties": {
            "pointer": { "type": "string" }, "returned": { "type": "string" }, "above": { "type": "integer", "minimum": 0 } } } } },
        "calleeSaved": { "type": "array", "items": { "type": "string" } },
        "eh": { "type": "object", "additionalProperties": false, "properties": {
          "dataRegs": { "type": "array", "items": { "type": "string" } } } },
        "vaList": { "enum": ["pointer", "struct"] },
        "types": { "type": "object", "additionalProperties": false,
          "patternProperties": { "^(char|short|int|long|longLong|pointer|float|double|longDouble)$": {
            "type": "object", "required": ["size"], "additionalProperties": false, "properties": {
              "size": { "enum": [1, 2, 4, 8, 16] }, "align": { "type": "integer", "minimum": 1 }, "signed": { "type": "boolean" } } } },
          "properties": { "sizeT": { "type": "string" }, "wcharT": { "type": "string" } } },
        "breakpoint": { "type": "string", "description": "The instruction a debugger writes for a software breakpoint." }
      }
    },
    "helpers": {
      "type": "object",
      "description": "Operations the semantics vocabulary can't express, each written by hand in every writer, declared with the fields, registers and flags it reads (uses) and writes (defs).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uses", "defs"],
        "properties": {
          "uses": { "type": "array", "items": { "type": "string" } },
          "defs": { "type": "array", "items": { "type": "string" } },
          "sideEffects": { "type": "boolean" }
        }
      }
    }
  },
  "if": { "required": ["cpuName"], "not": { "required": ["include"] } },
  "then": {
    "description": "A complete machine file, standing alone: its whole structure. A file with \"include\", or a fragment (no \"cpuName\"), is an overlay: ptasm checks the merged result.",
    "required": ["cpuName", "description", "fields", "instructions"],
    "properties": {
      "description": { "$ref": "#/$defs/description" },
      "elf": { "$ref": "#/$defs/elf" },
      "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } },
      "formats": { "type": "object", "additionalProperties": { "$ref": "#/$defs/layout" } },
      "modes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/setValues" } },
      "operandSets": {
        "type": "object",
        "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "modeSets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/family" } },
      "instructions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/instruction" } }
    }
  },
  "$defs": {
    "sem": {
      "type": "string",
      "description": "What an instruction does, in micro-ops: statements separated by ';', every operation a call (set(rd, add(rs1, rs2)); if(c, set(PC, target))), or the name of a \"semSets\" entry. ptasm checks it when it loads the file: the grammar, each operation, every name (a field of the form, a register, a flag, a temporary, PC, pc.next)."
    },
    "delaySlot": {
      "type": "integer", "minimum": 0, "maximum": 8,
      "description": "How many instructions after a jump run before it takes effect (OR1K, SPARC: 1). On a mode set or an instruction; the instruction's wins."
    },
    "semArgs": {
      "type": "object",
      "description": "The text each {placeholder} in the sem stands for.",
      "additionalProperties": { "type": "string" }
    },
    "register": {
      "description": "A register's name: its number (\"BX\": 3), or an object. In the object, a general register has a number; the program counter may have none (role pc); a register outside the general ones has a space and an index there; a part of another names its parent, its lsb there and how writing it treats the rest; an alias names the register it is another name for, and nothing else.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "number": { "type": "integer", "minimum": 0 },
            "bits": { "type": "integer", "minimum": 1, "maximum": 64 },
            "role": { "enum": ["pc", "sp", "link", "flags"] },
            "const": { "type": "integer" },
            "space": { "type": "string" },
            "index": { "type": "integer", "minimum": 0 },
            "parent": { "type": "string" },
            "lsb": { "type": "integer", "minimum": 0 },
            "writes": { "enum": ["merge", "zeroExtend"] },
            "alias": { "type": "string" },
            "flags": {
              "type": "object",
              "description": "A flags register's flags, each by its bit: { \"C\": 0, \"Z\": 1 }. Semantics read and write them by name.",
              "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 63 }
            }
          }
        }
      ]
    },
    "value": {
      "description": "A constant: \"0b0101\", \"0x10\", or a non-negative integer.",
      "oneOf": [
        { "type": "string", "pattern": "^(0[bB][01]+|0[xX][0-9a-fA-F]+|[0-9]+)$" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "setValues": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
    "description": {
      "type": "object",
      "required": ["regCount", "addressBits", "byteOrder"],
      "additionalProperties": false,
      "properties": {
        "regCount": { "type": "integer", "minimum": 0 },
        "regBits": { "type": "integer", "minimum": 1, "maximum": 64 },
        "addressBits": { "type": "integer", "minimum": 1, "maximum": 64 },
        "byteOrder": { "enum": ["little", "big"] },
        "relOffset": { "enum": ["before", "after"] }
      }
    },
    "elf": {
      "type": "object",
      "required": ["elfClass", "relocations"],
      "additionalProperties": false,
      "properties": {
        "eMachine": { "type": "integer", "minimum": 0 },
        "elfClass": { "enum": [32, 64] },
        "relocationFormat": { "enum": ["rela", "rel"] },
        "globalJumps": { "enum": ["relocate", "resolve"] },
        "relocations": {
          "type": "object",
          "propertyNames": { "pattern": "^(addr[0-9]*(:signed)?|pcrel[0-9]*(:call|:jump)?)$" },
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "piece": {
      "type": "object",
      "required": ["bits", "lsb"],
      "additionalProperties": false,
      "properties": {
        "bits": { "type": "integer", "minimum": 1, "maximum": 64 },
        "lsb": { "type": "integer", "minimum": 0 },
        "valueLsb": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    },
    "field": {
      "type": "object",
      "required": ["build"],
      "additionalProperties": false,
      "properties": {
        "build": { "enum": ["con", "set", "reg", "imm", "pcrel", "addr", "scl"] },
        "bits": { "type": "integer", "minimum": 1, "maximum": 64 },
        "lsb": { "type": "integer", "minimum": 0 },
        "valueLsb": { "type": "integer", "minimum": 0, "maximum": 63 },
        "pieces": { "type": "array", "items": { "$ref": "#/$defs/piece" }, "minItems": 1 },
        "value": { "$ref": "#/$defs/value" },
        "target": { "enum": ["data", "call", "jump"] },
        "signed": { "type": "boolean" },
        "round": { "type": "boolean" },
        "relocation": { "type": "integer", "minimum": 0 }
      },
      "oneOf": [
        { "required": ["pieces"], "not": { "anyOf": [{ "required": ["bits"] }, { "required": ["lsb"] }] } },
        { "required": ["bits", "lsb"], "not": { "required": ["pieces"] } }
      ],
      "if": { "properties": { "build": { "const": "con" } } },
      "then": { "required": ["value"] },
      "else": { "not": { "required": ["value"] } }
    },
    "layout": {
      "type": "object",
      "required": ["size", "fields"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "fields": { "type": "array", "items": { "type": "string" } },
        "unused": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" } }
      }
    },
    "formatMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "family": {
      "type": "object",
      "required": ["patterns"],
      "additionalProperties": false,
      "patternProperties": {
        "^op[1-9]$": {
          "type": "object",
          "propertyNames": { "pattern": "^(reg|num)[12]$" },
          "additionalProperties": { "type": "string" }
        }
      },
      "properties": {
        "formats": { "$ref": "#/$defs/formatMap" },
        "set": { "$ref": "#/$defs/setValues" },
        "sem": { "$ref": "#/$defs/sem" },
        "semArgs": { "$ref": "#/$defs/semArgs" },
        "delaySlot": { "$ref": "#/$defs/delaySlot" },
        "patterns": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modeFrom": { "type": "string", "pattern": "^op[1-9]$" },
              "set": { "$ref": "#/$defs/setValues" },
              "formats": { "$ref": "#/$defs/formatMap" }
            }
          }
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string" },
        "size": { "type": "integer", "minimum": 1 },
        "fields": { "type": "array", "items": { "type": "string" } },
        "unused": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" } },
        "set": { "$ref": "#/$defs/setValues" },
        "from": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^op[1-9]\\.(reg|num)[12]$" }
        },
        "bytes": { "type": "string", "pattern": "^\\s*(0[xX][0-9a-fA-F]{1,2}|[0-9]{1,3})(\\s+(0[xX][0-9a-fA-F]{1,2}|[0-9]{1,3}))*\\s*$" },
        "sem": { "$ref": "#/$defs/sem" },
        "semArgs": { "$ref": "#/$defs/semArgs" }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modeSet": { "type": "string" },
        "set": { "$ref": "#/$defs/setValues" },
        "only": { "type": "array", "items": { "type": "string" } },
        "remove": { "type": "array", "items": { "type": "string" } },
        "forms": { "type": "object", "additionalProperties": { "$ref": "#/$defs/override" } },
        "sem": { "$ref": "#/$defs/sem" },
        "semArgs": { "$ref": "#/$defs/semArgs" },
        "delaySlot": { "$ref": "#/$defs/delaySlot" },
        "target": { "$ref": "#/$defs/target" },
        "commutes": { "$ref": "#/$defs/commutes" },
        "sideEffects": { "type": "boolean", "description": "Worked out from the semantics; written plainly it must agree, so an override goes in \"replace\"." },
        "operands": { "type": "string", "description": "A pseudo-instruction's operand pattern, each operand named for \"becomes\": \"rd:reg, value:imm\"." },
        "becomes": {
          "description": "A pseudo-instruction: what it is assembled as, in assembly text (Intel order; instructions separated by ';'), or alternatives tried in order, each with a \"when\" (fits(name, bits) or fitsu(name, bits)) but the last.",
          "oneOf": [
            { "type": "string" },
            { "type": "array", "minItems": 1, "items": { "oneOf": [
              { "type": "string" },
              { "type": "object", "required": ["do"], "additionalProperties": false,
                "properties": { "when": { "type": "string" }, "do": { "type": "string" } } } ] } }
          ]
        },
        "replace": {
          "type": "object",
          "description": "Overrides of the facts the semantics work out.",
          "additionalProperties": false,
          "properties": {
            "target": { "$ref": "#/$defs/target" },
            "commutes": { "$ref": "#/$defs/commutes" },
            "sideEffects": { "type": "boolean" }
          }
        }
      }
    },
    "target": {
      "enum": ["data", "call", "jump"],
      "description": "What the instruction's pc-relative field is: a call's target, a jump's, or data. Worked out from the semantics; written for an instruction without them."
    },
    "commutes": {
      "description": "The two register fields that may swap, or false. Worked out from the semantics.",
      "oneOf": [ { "const": false }, { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 } ]
    }
  }
}
