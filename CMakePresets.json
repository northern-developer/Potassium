{
  "version": 2,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Configuration",
      "description": "Default configuration for building the library",
      "binaryDir": "${sourceDir}/build/default",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "PTASM_INSTALL": "OFF",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "test",
      "displayName": "Test Configuration",
      "description": "Configuration for building and running tests",
      "binaryDir": "${sourceDir}/build/test",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "PTASM_INSTALL": "OFF",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "docs",
      "displayName": "Documentation Configuration",
      "description": "Configuration for building documentation",
      "binaryDir": "${sourceDir}/build/docs",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "BUILD_DOCS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang-Tidy Configuration",
      "description": "Configuration for running clang-tidy static analysis",
      "binaryDir": "${sourceDir}/build/clang-tidy",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "PTASM_CLANG_TIDY": "clang-tidy-21",
        "PTASM_INSTALL": "OFF",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan+UBSan Configuration",
      "description": "Debug build instrumented with AddressSanitizer and UndefinedBehaviorSanitizer",
      "binaryDir": "${sourceDir}/build/asan",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "PTASM_INSTALL": "OFF",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "release",
      "displayName": "Release-Level Tests",
      "description": "-O2 (RelWithDebInfo) build with the release-level tests (E8.T1): every example under Valgrind, determinism and ELF lint",
      "binaryDir": "${sourceDir}/build/release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "PTASM_RELEASE_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "PTASM_INSTALL": "OFF",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "description": "Clang source-based coverage (llvm-cov) of the test suite (E8.T1)",
      "binaryDir": "${sourceDir}/build/coverage",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_C_COMPILER": "clang-21",
        "CMAKE_CXX_COMPILER": "clang++-21",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "PTASM_INSTALL": "OFF",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzz Configuration",
      "description": "Clang build with libFuzzer + ASan + UBSan for the tests/fuzz/ harnesses",
      "binaryDir": "${sourceDir}/build/fuzz",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_C_COMPILER": "clang-21",
        "CMAKE_CXX_COMPILER": "clang++-21",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined,fuzzer-no-link -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "PTASM_FUZZ": "ON",
        "PTASM_INSTALL": "OFF",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan Configuration",
      "description": "Debug build instrumented with ThreadSanitizer (mutually exclusive with ASan)",
      "binaryDir": "${sourceDir}/build/tsan",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "PTASM_INSTALL": "OFF",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "init",
      "displayName": "Initialize Templates",
      "description": "Force regeneration of template files (CMakePresets.json, CI, etc.)",
      "binaryDir": "${sourceDir}/build/init",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CPP_LIBRARY_FORCE_INIT": "ON",
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "displayName": "Default Build", "configurePreset": "default" },
    { "name": "test", "displayName": "Build Tests", "configurePreset": "test" },
    { "name": "docs", "displayName": "Build Docs", "configurePreset": "docs", "targets": "docs" },
    { "name": "asan", "displayName": "Build with ASan+UBSan", "configurePreset": "asan" },
    { "name": "release", "displayName": "Build for the Release-Level Tests", "configurePreset": "release" },
    { "name": "coverage", "displayName": "Build with Coverage", "configurePreset": "coverage" },
    { "name": "fuzz", "displayName": "Build Fuzz Targets", "configurePreset": "fuzz" },
    { "name": "tsan", "displayName": "Build with TSan", "configurePreset": "tsan" },
    { "name": "clang-tidy", "displayName": "Build with Clang-Tidy", "configurePreset": "clang-tidy" },
    { "name": "init", "displayName": "Initialize Templates", "configurePreset": "init" }
  ],
  "testPresets": [
    { "name": "test", "displayName": "Run All Tests", "configurePreset": "test", "output": { "outputOnFailure": true } },
    { "name": "asan", "displayName": "Run Tests under ASan+UBSan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "release", "displayName": "Run the Release-Level Tests", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "coverage", "displayName": "Run Tests for Coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true },
      "environment": { "LLVM_PROFILE_FILE": "${sourceDir}/build/coverage/profiles/%p-%m.profraw" } },
    { "name": "tsan", "displayName": "Run Tests under TSan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "clang-tidy", "displayName": "Run Tests with Clang-Tidy", "configurePreset": "clang-tidy", "output": { "outputOnFailure": true } },
    { "name": "init", "displayName": "Initialize Templates", "configurePreset": "init", "output": { "outputOnFailure": true } }
  ]
}
